# Configurações do servidor
HOST=127.0.0.1
PORT=8080
MODE=dev

# Configurações do PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=meu_usuario
POSTGRES_PASSWORD=minha_senha
POSTGRES_DB=meu_banco_de_dados

# PostgreSQL exclusivo para testes
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=5434
TEST_POSTGRES_USER=sidebrain_test
TEST_POSTGRES_PASSWORD=sidebrain_test
TEST_POSTGRES_DB=sidebrain_test

# Configurações do Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH_DB=2

# Autenticação (gere com: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=chave-secreta
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Provedor de geração: usa OpenAI quando OPENAI_CHAT_API_KEY estiver definida;
# caso contrário, usa Groq.
GROQ_API_KEY=chave-secreta
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_CHAT_API_KEY=chave-secreta
OPENAI_CHAT_MODEL=gpt-6-luna

# Configuração RAG
OPENAI_API_KEY=
RAG_ROUTER_CONFIDENCE_THRESHOLD=0.80
RAG_SOURCES_CONFIG=config/rag_sources.yml
