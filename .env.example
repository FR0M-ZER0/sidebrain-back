# Configurações do servidor
HOST=127.0.0.1
PORT=8080
MODE=dev

# Configurações do PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=meu_usuario
POSTGRES_PASSWORD=minha_senha
POSTGRES_DB=meu_banco_de_dados

# Configurações do Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH_DB=2

# Autenticação (gere com: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=SUBSTITUA_COM_UM_SEGREDO_ALEATORIO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configurações do Groq
GROQ_API_KEY=sua_chave_de_api
GROQ_MODEL=llama-3.3-70b-versatile

# Configuração RAG
OPENAI_API_KEY=
RAG_ROUTER_CONFIDENCE_THRESHOLD=0.80
RAG_SOURCES_CONFIG=config/rag_sources.yml
